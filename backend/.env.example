PORT=9000
HOST=0.0.0.0
LOW_THRESHOLD=15
MEDIUM_THRESHOLD=70
HIGH_THRESHOLD=70
FUSION_WEIGHT_AASIST=0.15
FUSION_WEIGHT_RAWNET2=0.2
FUSION_WEIGHT_XLSR=0.15
FUSION_WEIGHT_ANTIDEEPFAKE=0.5
# Real pretrained detector (NII AntiDeepfake, CC BY-NC-SA 4.0, non-commercial)
# Set false to run heuristics only. DEVICE: auto (=cuda if available else cpu)
REAL_MODEL_ENABLED=true
REAL_MODEL_DEVICE=auto
# REAL_MODEL_PATH defaults to backend/checkpoints/anti-deepfake-small.safetensors
# (auto-downloaded from HuggingFace on first run if missing)
# Arena true-detection model: W2V2-AASIST (MIT, ONNX ~1.2GB, CPU inference)
# Auto-downloaded to backend/checkpoints/w2v2-aasist.onnx on first run if missing.
# Weight is deliberately modest (0.15): validated safe on sample calls
# (genuine stays low, cloned stays high), but the model itself is
# uncalibrated on our toy files — see backend README / HANDOFF validation gap.
W2V2_AASIST_ENABLED=true
# W2V2_AASIST_DEVICE=auto uses the RTX GPU when onnxruntime-gpu is installed
# (cuda if available else cpu). Set cpu to keep VRAM free for torch models.
W2V2_AASIST_DEVICE=auto
# W2V2_AASIST_PATH= custom path override (default: checkpoints/w2v2-aasist.onnx)
FUSION_WEIGHT_W2V2_AASIST=0.15
# Arena true-detection model: DF Arena 500M (best-effort HF pipeline, ~1.7GB)
# NOTE: upstream repo is currently missing its custom-code files, so this
# model logs the reason and stays out of the fusion until upstream (or a fork
# via DF_ARENA_REPO) publishes them.
DF_ARENA_ENABLED=true
DF_ARENA_DEVICE=auto
FUSION_WEIGHT_DF_ARENA=0.2
FEATURE_ONLY_LOGGING=false
REPLAY_CHUNK_SECONDS=2
# Pretrained detectors score a rolling 4s window (their native operating
# point); smoothing = mean of last 3 chunk scores; sustained medium+ over
# 2 consecutive chunks also raises an alert (catches real TTS hovering
# below the high line).
REAL_WINDOW_SECONDS=4
SMOOTHING_CHUNKS=3
ALERT_PERSIST_CHUNKS=2
DATABASE_URL=sqlite:///./voice_guard.db
ALLOW_ORIGINS=*
# Asterisk / SIP
# For WSL (no Docker): ENABLE_ASTERISK=true  ARI_URL=http://localhost:8088/ari  SIP_WS_URL=ws://localhost:8088/ws
# For Docker: ARI_URL=http://asterisk:8088/ari
ENABLE_ASTERISK=false
ARI_URL=http://localhost:8088/ari
ARI_USER=voice-guard
ARI_PASS=voice-guard-secret
SIP_WS_URL=ws://localhost:8088/ws
SIP_DOMAIN=localhost
